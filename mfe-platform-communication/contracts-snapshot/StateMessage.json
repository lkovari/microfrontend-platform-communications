{
  "type": "object",
  "properties": {
    "messageName": {
      "type": "string",
      "minLength": 1
    },
    "messageVersion": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "occurredAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "const": "state"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "validationDescriptor": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "max": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "stateKey": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "replace",
        "patch",
        "remove",
        "reset"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {}
  },
  "required": [
    "messageName",
    "messageVersion",
    "messageId",
    "correlationId",
    "source",
    "occurredAtUtc",
    "kind",
    "sensitivity",
    "stateKey",
    "operation",
    "revision"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
